{
  "name": "fundamentals-project-ts-template",
  "version": "1.0.0",
  "description": "Capstone Project TS Template",
  "main": "index.js",
  "scripts": {
    "ts-compile": "tsc",
    "compile:scss": "sass src/scss/main.scss dist/main.css",
    "compile:ts": "tsc",
    "copy:assets": "copyfiles -u 2 src/assets/**/* dist/assets",
    "watch:scss": "sass --watch src/scss/main.scss dist/main.css",
    "watch:ts": "tsc --watch",
    "watch:assets": "chokidar \"src/assets/**/*\" -c \"npm run copy:assets\"",
    "dev": "npm-run-all --parallel watch:scss watch:ts watch:assets",
    "lint:ts": "eslint \"src/**/*.ts\"",
    "lint:scss": "stylelint \"src/**/*.scss\"",
    "lint": "npm run lint:ts && npm run lint:scss"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "chokidar-cli": "^3.0.0",
    "copyfiles": "^2.4.1",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "npm-run-all": "^4.1.5",
    "sass": "^1.99.0",
    "stylelint": "^17.8.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.0.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.59.0"
  }
}